{
  "name": "pawprint-api",
  "version": "0.1.0",
  "private": true,
  "description": "PawPrint REST API - Express + Microsoft SQL Server",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
