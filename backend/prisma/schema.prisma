// =============================================================================
//  PawPrint – Prisma schema (TiDB / MySQL protocol)
//  Nguồn sự thật của DB là database/pawprint_tidb.sql.
//  File này phản chiếu 1-1 schema SQL; KHÔNG dùng `prisma migrate`.
//  Nếu sửa SQL, có thể chạy `npm run prisma:pull` để đối chiếu.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------- enums

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  HAMSTER
  FISH
  REPTILE
  OTHER
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum MomentVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum MediaStatus {
  UNATTACHED
  ATTACHED
}

enum CareRecordType {
  WEIGHT
  BATH
  NAIL_TRIM
  VET_VISIT
  NOTE
  OTHER
}

enum MilestoneType {
  TOGETHER_100
  TOGETHER_365
  TOGETHER_1000
  BIRTHDAY
  ADOPTION_ANNIVERSARY
  CUSTOM
}

enum NotificationType {
  WEIGHT_REMINDER
  MILESTONE
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum RecapPeriod {
  MONTH
  YEAR
}

enum BillingPeriod {
  NONE
  MONTH
  YEAR
}

enum SubscriptionProvider {
  APP_STORE
  GOOGLE_PLAY
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum WebhookProvider {
  APP_STORE
  GOOGLE_PLAY
}

// ----------------------------------------------------------------------------- auth & users

model User {
  id              String     @id @db.Char(36)
  email           String     @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  displayName     String?    @map("display_name") @db.VarChar(100)
  timeZone        String     @default("Asia/Ho_Chi_Minh") @map("time_zone") @db.VarChar(64)
  locale          String     @default("vi") @db.VarChar(10)
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  currentPetId    String?    @map("current_pet_id") @db.Char(36)
  notifyEnabled   Boolean    @default(true) @map("notify_enabled")
  aiConsentAt     DateTime?  @map("ai_consent_at") @db.DateTime(3)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.DateTime(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime?  @map("deleted_at") @db.DateTime(3)

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  deviceTokens       DeviceToken[]
  pets               Pet[]
  moments            Moment[]
  media              MomentMedia[]
  careRecords        CareRecord[]
  milestones         Milestone[]
  notifications      Notification[]
  subscriptions      Subscription[]

  @@index([status], map: "idx_users_status")
  @@map("users")
}

model RefreshToken {
  id           String    @id @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  tokenHash    String    @unique(map: "uq_refresh_tokens_hash") @map("token_hash") @db.Char(64)
  familyId     String    @map("family_id") @db.Char(36)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById String?   @map("replaced_by_id") @db.Char(36)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_refresh_tokens_user")

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String              @id @db.Char(36)
  userId    String              @map("user_id") @db.Char(36)
  purpose   VerificationPurpose
  tokenHash String              @unique(map: "uq_verification_tokens_hash") @map("token_hash") @db.Char(64)
  expiresAt DateTime            @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?           @map("used_at") @db.DateTime(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_verification_tokens_user")

  @@index([userId, purpose], map: "idx_verification_tokens_user_purpose")
  @@map("verification_tokens")
}

model DeviceToken {
  id         String         @id @db.Char(36)
  userId     String         @map("user_id") @db.Char(36)
  platform   DevicePlatform
  token      String         @unique(map: "uq_device_tokens_token") @db.VarChar(512)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.DateTime(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_device_tokens_user")

  @@index([userId], map: "idx_device_tokens_user")
  @@map("device_tokens")
}

// ----------------------------------------------------------------------------- pets

model Pet {
  id               String     @id @db.Char(36)
  userId           String     @map("user_id") @db.Char(36)
  name             String     @db.VarChar(100)
  species          PetSpecies @default(OTHER)
  breed            String?    @db.VarChar(100)
  sex              PetSex     @default(UNKNOWN)
  birthDate        DateTime?  @map("birth_date") @db.Date
  adoptedAt        DateTime?  @map("adopted_at") @db.Date
  weightKg         Decimal?   @map("weight_kg") @db.Decimal(6, 2)
  avatarStorageKey String?    @map("avatar_storage_key") @db.VarChar(255)
  note             String?    @db.Text
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime?  @map("deleted_at") @db.DateTime(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_pets_user")
  moments       Moment[]
  careRecords   CareRecord[]
  milestones    Milestone[]
  notifications Notification[]
  recaps        Recap[]

  @@index([userId, deletedAt], map: "idx_pets_user")
  @@index([adoptedAt], map: "idx_pets_adopted")
  @@map("pets")
}

// ----------------------------------------------------------------------------- moments

model Moment {
  id         String           @id @db.Char(36)
  petId      String           @map("pet_id") @db.Char(36)
  userId     String           @map("user_id") @db.Char(36)
  caption    String?          @db.VarChar(2000)
  occurredAt DateTime         @map("occurred_at") @db.DateTime(3)
  visibility MomentVisibility @default(PRIVATE)
  version    Int              @default(1)
  createdAt  DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt  DateTime?        @map("deleted_at") @db.DateTime(3)

  pet   Pet           @relation(fields: [petId], references: [id], onDelete: Cascade, map: "fk_moments_pet")
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_moments_user")
  media MomentMedia[]

  @@index([petId, deletedAt, occurredAt], map: "idx_moments_pet_occurred")
  @@index([userId, deletedAt], map: "idx_moments_user")
  @@map("moments")
}

model MomentMedia {
  id              String      @id @db.Char(36)
  userId          String      @map("user_id") @db.Char(36)
  momentId        String?     @map("moment_id") @db.Char(36)
  status          MediaStatus @default(UNATTACHED)
  storageProvider String      @default("cloudinary") @map("storage_provider") @db.VarChar(20)
  storageKey      String      @unique(map: "uq_moment_media_storage_key") @map("storage_key") @db.VarChar(255)
  mimeType        String      @map("mime_type") @db.VarChar(100)
  format          String?     @db.VarChar(20)
  sizeBytes       Int         @map("size_bytes")
  width           Int?
  height          Int?
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_moment_media_user")
  moment Moment? @relation(fields: [momentId], references: [id], onDelete: Cascade, map: "fk_moment_media_moment")

  @@index([momentId, sortOrder], map: "idx_moment_media_moment")
  @@index([userId, status, createdAt], map: "idx_moment_media_user_status")
  @@map("moment_media")
}

// ----------------------------------------------------------------------------- care diary

model CareRecord {
  id           String         @id @db.Char(36)
  petId        String         @map("pet_id") @db.Char(36)
  userId       String         @map("user_id") @db.Char(36)
  type         CareRecordType
  valueDecimal Decimal?       @map("value_decimal") @db.Decimal(10, 3)
  unit         String?        @db.VarChar(20)
  title        String?        @db.VarChar(200)
  note         String?        @db.Text
  occurredAt   DateTime       @map("occurred_at") @db.DateTime(3)
  version      Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime?      @map("deleted_at") @db.DateTime(3)

  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade, map: "fk_care_records_pet")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_care_records_user")

  @@index([petId, deletedAt, occurredAt], map: "idx_care_records_pet_occurred")
  @@index([petId, type, deletedAt, occurredAt], map: "idx_care_records_pet_type")
  @@index([userId], map: "idx_care_records_user")
  @@map("care_records")
}

// ----------------------------------------------------------------------------- milestones

model Milestone {
  id            String        @id @db.Char(36)
  petId         String        @map("pet_id") @db.Char(36)
  userId        String        @map("user_id") @db.Char(36)
  type          MilestoneType
  milestoneDate DateTime      @map("milestone_date") @db.Date
  title         String        @db.VarChar(200)
  note          String?       @db.VarChar(1000)
  isSystem      Boolean       @default(false) @map("is_system")
  dedupeKey     String?       @map("dedupe_key") @db.VarChar(100)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime?     @map("deleted_at") @db.DateTime(3)

  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade, map: "fk_milestones_pet")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_milestones_user")

  @@unique([petId, dedupeKey], map: "uq_milestones_pet_dedupe")
  @@index([petId, deletedAt, milestoneDate], map: "idx_milestones_pet_date")
  @@map("milestones")
}

// ----------------------------------------------------------------------------- notifications

model Notification {
  id          String             @id @db.Char(36)
  userId      String             @map("user_id") @db.Char(36)
  petId       String?            @map("pet_id") @db.Char(36)
  type        NotificationType
  title       String             @db.VarChar(200)
  body        String             @db.VarChar(1000)
  dataJson    Json?              @map("data_json")
  dedupeKey   String?            @map("dedupe_key") @db.VarChar(150)
  status      NotificationStatus @default(PENDING)
  scheduledAt DateTime           @default(now()) @map("scheduled_at") @db.DateTime(3)
  sentAt      DateTime?          @map("sent_at") @db.DateTime(3)
  readAt      DateTime?          @map("read_at") @db.DateTime(3)
  retryCount  Int                @default(0) @map("retry_count")
  lastError   String?            @map("last_error") @db.VarChar(500)
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_notifications_user")
  pet  Pet? @relation(fields: [petId], references: [id], onDelete: SetNull, map: "fk_notifications_pet")

  @@unique([userId, dedupeKey], map: "uq_notifications_user_dedupe")
  @@index([userId, createdAt], map: "idx_notifications_user_created")
  @@index([status, scheduledAt], map: "idx_notifications_status_scheduled")
  @@map("notifications")
}

// ----------------------------------------------------------------------------- recap (V1.1)

model Recap {
  id          String      @id @db.Char(36)
  petId       String      @map("pet_id") @db.Char(36)
  periodType  RecapPeriod @map("period_type")
  periodStart DateTime    @map("period_start") @db.Date
  payloadJson Json        @map("payload_json")
  generatedAt DateTime    @default(now()) @map("generated_at") @db.DateTime(3)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade, map: "fk_recaps_pet")

  @@unique([petId, periodType, periodStart], map: "uq_recaps_pet_period")
  @@map("recaps")
}

// ----------------------------------------------------------------------------- plans & subscriptions

model Plan {
  id                String        @id @db.VarChar(32)
  name              String        @db.VarChar(100)
  description       String?       @db.VarChar(500)
  price             Decimal       @default(0) @db.Decimal(12, 2)
  currency          String        @default("VND") @db.Char(3)
  billingPeriod     BillingPeriod @default(NONE) @map("billing_period")
  maxPets           Int?          @map("max_pets")
  maxMoments        Int?          @map("max_moments")
  maxMediaPerMoment Int           @default(5) @map("max_media_per_moment")
  maxStorageMb      Int?          @map("max_storage_mb")
  isActive          Boolean       @default(true) @map("is_active")
  sortOrder         Int           @default(0) @map("sort_order")
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String               @id @db.Char(36)
  userId                 String               @map("user_id") @db.Char(36)
  planId                 String               @map("plan_id") @db.VarChar(32)
  provider               SubscriptionProvider
  externalSubscriptionId String               @map("external_subscription_id") @db.VarChar(255)
  status                 SubscriptionStatus
  startedAt              DateTime             @map("started_at") @db.DateTime(3)
  expiresAt              DateTime?            @map("expires_at") @db.DateTime(3)
  autoRenew              Boolean              @default(true) @map("auto_renew")
  createdAt              DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_subscriptions_user")
  plan Plan @relation(fields: [planId], references: [id], map: "fk_subscriptions_plan")

  @@unique([provider, externalSubscriptionId], map: "uq_subscriptions_provider_external")
  @@index([userId, status, expiresAt], map: "idx_subscriptions_user_status")
  @@map("subscriptions")
}

model PaymentWebhookEvent {
  id          String          @id @db.Char(36)
  provider    WebhookProvider
  eventId     String          @map("event_id") @db.VarChar(255)
  payloadJson Json            @map("payload_json")
  processedAt DateTime?       @map("processed_at") @db.DateTime(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([provider, eventId], map: "uq_payment_webhook_events")
  @@map("payment_webhook_events")
}

// ----------------------------------------------------------------------------- shop (V2)

model Product {
  id           String   @id @db.Char(36)
  name         String   @db.VarChar(200)
  description  String?  @db.Text
  imageUrl     String?  @map("image_url") @db.VarChar(1024)
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @default("VND") @db.Char(3)
  affiliateUrl String?  @map("affiliate_url") @db.VarChar(1024)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([isActive], map: "idx_products_active")
  @@map("products")
}

// ----------------------------------------------------------------------------- audit

model AuditLog {
  id           String   @id @db.Char(36)
  actorUserId  String?  @map("actor_user_id") @db.Char(36)
  action       String   @db.VarChar(100)
  entityType   String?  @map("entity_type") @db.VarChar(50)
  entityId     String?  @map("entity_id") @db.Char(36)
  metadataJson Json?    @map("metadata_json")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([actorUserId, createdAt], map: "idx_audit_logs_actor")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}
