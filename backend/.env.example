# ---------------------------------------------------------------
# PawPrint backend – copy thành .env và điền giá trị thật
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Danh sách origin cho CORS (phân tách dấu phẩy). Để trống = chặn tất cả origin trình duyệt
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Số proxy phía trước (Nginx/Load balancer) để lấy IP thật cho rate limit
TRUST_PROXY=0
LOG_LEVEL=debug

# ---------------- TiDB (MySQL protocol) ----------------
# TiDB self-hosted:  mysql://user:pass@host:4000/pawprint
# TiDB Cloud Serverless (bắt buộc TLS):
#   mysql://<user>:<pass>@gateway01.<region>.prod.aws.tidbcloud.com:4000/pawprint?sslaccept=strict
DATABASE_URL="mysql://root:@127.0.0.1:4000/pawprint"

# ---------------- JWT ----------------
# Sinh secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------- Cloudinary ----------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Thư mục gốc trên Cloudinary
CLOUDINARY_FOLDER=pawprint
# Giới hạn upload (cần chốt với khách hàng)
MEDIA_MAX_BYTES=10485760
MEDIA_ALLOWED_FORMATS=jpg,jpeg,png,webp,heic
# Ảnh upload nhưng không gắn vào moment sau N giờ sẽ bị xoá
MEDIA_UNATTACHED_TTL_HOURS=24

# ---------------- Email (SMTP) ----------------
# Để trống SMTP_HOST => email chỉ được ghi ra log (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PawPrint <no-reply@pawprint.app>"
# Link trong email (deep link app hoặc trang web)
APP_PUBLIC_URL=pawprint://

# ---------------- Jobs ----------------
# Chỉ bật trên 1 instance khi scale ngang
JOBS_ENABLED=true
# Giờ địa phương (theo time_zone của user) gửi nhắc nhở hằng ngày
REMINDER_LOCAL_HOUR=9
WEIGHT_REMINDER_DAYS=30
# Push provider: log (MVP) | fcm (chưa triển khai)
PUSH_PROVIDER=log
