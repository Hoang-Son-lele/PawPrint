# Sao chép thành backend/.env và sửa các giá trị theo SQL Server máy bạn.
NODE_ENV=development
PORT=3000

# Cách 1: SQL Server mặc định -> DB_SERVER=localhost, DB_PORT=1433, DB_INSTANCE=
# Cách 2: SQL Express -> DB_SERVER=localhost, DB_PORT=, DB_INSTANCE=SQLEXPRESS
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=PawPrintDB
DB_USER=pawprint_app
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Cấu hình minh họa chỉ dành cho phát triển local.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Tạo secret đủ dài, ngẫu nhiên, không commit vào Git.
JWT_SECRET=REPLACE_THIS_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=15m

# Để trống: chỉ cần API cho mobile native, dev cho phép request từ các origin.
# Khi triển khai web cần cấu hình danh sách origin cho phép.
CORS_ORIGIN=

# Cloudinary photo uploads (implemented): fill these three settings on backend.
# Uploads are signed on backend; no unsigned preset is required.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Other integration settings reserved for future adapters.
# These variables alone DO NOT activate storage/email/push/billing adapters.
# Keep all secrets on backend, never use EXPO_PUBLIC_ for these values.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
PUSH_PROVIDER=
PUSH_PROJECT_ID=
PUSH_CREDENTIALS_FILE=
BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
