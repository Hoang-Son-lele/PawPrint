{
  "expo": {
    "name": "PawPrint",
    "slug": "pawprint",
    "scheme": "pawprint",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.pawprint"
    },
    "android": {
      "package": "com.example.pawprint",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8F3"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép PawPrint chọn ảnh để lưu khoảnh khắc của bé.",
          "cameraPermission": "Cho phép PawPrint chụp ảnh để lưu khoảnh khắc của bé.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
